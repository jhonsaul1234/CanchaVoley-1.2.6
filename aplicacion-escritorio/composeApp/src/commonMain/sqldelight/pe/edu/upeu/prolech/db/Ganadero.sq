-- Tabla heredada de ProLech. CanchaVoley no la usa: se conserva solo para que las bases locales
-- creadas antes (etapa 0) sigan igual y las migraciones 1.sqm-5.sqm no cambien. Sin consultas.

CREATE TABLE GanaderoEntity (
    id         INTEGER NOT NULL PRIMARY KEY,
    nombre     TEXT    NOT NULL,
    dni        TEXT    NOT NULL,
    -- 1 = suspendido por faltas de calidad, 0 = activo
    suspendido INTEGER NOT NULL DEFAULT 0,
    -- Entregas que aún no puede hacer por una sanción de calidad
    bloqueado  INTEGER NOT NULL DEFAULT 0,
    -- Código del frasco si hoy le toca muestra sorpresa (null = no)
    muestra    TEXT
);
